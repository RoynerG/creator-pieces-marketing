{
  "name": "creator-pieces-marketing",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "desktop:prepare": "node node_modules/electron/install.js",
    "desktop": "npm run build && npm run desktop:prepare && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win": "npm run build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "electron-updater": "6.8.11",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "vite": "7.3.7"
  },
  "main": "desktop/main.js",
  "description": "Creador local de publicaciones inmobiliarias con SQLite",
  "author": "RoynerG",
  "repository": {
    "type": "git",
    "url": "https://github.com/RoynerG/creator-pieces-marketing.git"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
